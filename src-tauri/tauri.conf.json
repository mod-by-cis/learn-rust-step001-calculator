{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lekcja003-kalkulator-gui",
  "version": "0.1.0",
  "identifier": "com.gepiden.lekcja003.kalkulator.gui",
  "build": {
    "frontendDist": "../src-deno/dist"
  },
  "app": {
